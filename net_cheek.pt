# Network Ping Status Checker Simulation

ip = input("Ping ke liye IP Address daalein (e.g., 8.8.8.8): ")

if ip == "8.8.8.8" or ip == "127.0.0.1":
    print("✅ Status: Host is UP! Latency: 12ms")
elif ip == "":
    print("⚠️ Error: IP Address khali nahi chhod sakte!")
else:
    print("❌ Status: Request Timed Out (Host unreachable)")
